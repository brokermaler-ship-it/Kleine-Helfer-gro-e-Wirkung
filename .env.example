# LiveKit (lokal: `docker compose up livekit` nutzt devkey/secret)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Sprachdienste
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
# ID einer deutschsprachigen Cartesia-Stimme (in der Cartesia-Voice-Library nach "German" filtern)
CARTESIA_VOICE_ID=

# Optional
# TUTOR_LLM_MODEL=claude-sonnet-5-5
# TUTOR_LLM_EFFORT=low
# TUTOR_STT_MODEL=nova-3
# TUTOR_TTS_MODEL=sonic-3
# Wartezeit nach Sprechpausen in Sekunden (der Turn-Detector wählt dazwischen)
# TUTOR_ENDPOINTING_MIN_DELAY=0.5
# TUTOR_ENDPOINTING_MAX_DELAY=5.0
